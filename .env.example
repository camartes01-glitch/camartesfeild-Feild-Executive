# Copy to .env.local for local development. Do not commit real secrets.

# Dedicated Field Operations backend (FastAPI). Not the marketplace/Render API.
# Web / iOS simulator:
#   EXPO_PUBLIC_FIELD_OPS_API=http://127.0.0.1:8000
# Android emulator:
#   EXPO_PUBLIC_FIELD_OPS_API=http://10.0.2.2:8000
# Physical phone/tablet on the same LAN (replace with your PC IP):
#   EXPO_PUBLIC_FIELD_OPS_API=http://192.168.1.10:8000
#
# Production builds must set this to the dedicated Field Operations host.
# Leaving it empty in a production build will refuse Field Operations sync.
EXPO_PUBLIC_FIELD_OPS_API=http://127.0.0.1:8000

# Demo login (rahul@/priya@/arjun@/ops@camartes.com) is off in production unless this is true.
# EXPO_PUBLIC_DEMO_MODE=false
