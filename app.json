{
  "expo": {
    "name": "Camartes Field",
    "slug": "camartes-field",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "camartesfield",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.camartes.field",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Camartes Field uses your location for attendance, task distance and geotagged proofs.",
        "NSCameraUsageDescription": "Camartes Field takes geotagged photos at pickup, delivery and address verification."
      }
    },
    "android": {
      "package": "com.camartes.field",
      "adaptiveIcon": {
        "backgroundColor": "#FF6B35",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFF7ED"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Camartes Field uses your location for attendance, task distance and geotagged proofs."
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Camartes Field takes geotagged photos at pickup, delivery and address verification."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
